# Render / Production Environment Variables
NODE_ENV=production
PORT=5000
DB_NAME=mpc
# Paste your MongoDB Atlas URI here:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Generate a random 32+ character secret:
JWT_SECRET=replace_with_a_secure_random_32_character_secret_string
# URL of your frontend on Vercel (e.g. https://your-project.vercel.app):
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=Admin@12345
